<div id="plan-poker-content" class="room">
  <section class="task" aria-labelledby="taskTitle">
    <div class="task-text">
      <h1 class="task-title" id="taskTitle"><%= room.taskTitle %></h1>
      <% if (room.taskDescription) { %>
        <p class="task-description" id="taskDescription"><%- linkify(room.taskDescription) %></p>
      <% } %>
    </div>
    <div class="invite">
      <label class="field-label" for="roomLink">Invite the team</label>
      <div class="invite-row">
        <input type="text" id="roomLink" class="input input-link" readonly value="<%= roomUrl %>" />
        <button type="button" id="copyLinkBtn" class="btn btn-quiet">Copy link</button>
      </div>
    </div>
  </section>

  <section class="table" aria-labelledby="tableTitle">
    <div class="section-head">
      <h2 class="section-title" id="tableTitle">At the table</h2>
      <p class="section-meta" id="tableMeta" aria-live="polite"></p>
    </div>
    <ul class="plaques" id="membersGrid">
      <!-- Plaques are rendered by script.js -->
    </ul>
  </section>

  <section class="results" id="resultsSection" aria-labelledby="resultsTitle" hidden>
    <div class="section-head">
      <h2 class="section-title" id="resultsTitle">The split</h2>
    </div>
    <div class="results-body">
      <div class="average" id="averageDisplay">
        <span class="average-label">Average</span>
        <span class="average-value" id="averageValue">–</span>
        <span class="average-nearest" id="averageNearest"></span>
      </div>
      <ol class="split" id="votesBreakdown">
        <!-- Distribution rows are rendered by script.js -->
      </ol>
    </div>
  </section>

  <section class="deck" id="cardsSection" aria-labelledby="deckTitle">
    <div class="section-head">
      <h2 class="section-title" id="deckTitle">Your estimate</h2>
      <p class="section-meta" id="selectionDisplay" aria-live="polite">Tap a card to vote</p>
    </div>

    <div class="cards" id="cardsGrid" role="group" aria-labelledby="deckTitle">
      <!-- Cards are rendered by script.js -->
    </div>

    <p class="deck-hint">
      Type a card's number to vote<% if (userSession.isAdmin) { %> · <kbd>Shift</kbd> <kbd>R</kbd> reveals · <kbd>Shift</kbd> <kbd>N</kbd> starts a new round<% } %>
    </p>

  </section>

  <section class="actions" id="adminControls" aria-label="Facilitator actions" <%= userSession.isAdmin ? '' : 'hidden' %>>
    <div class="extend" id="extendPrompt" hidden>
      <span class="extend-text">The room closes soon.</span>
      <button type="button" class="btn btn-quiet btn-compact" id="extendBtn">Add 5 minutes</button>
    </div>
    <div class="admin">
      <button type="button" class="btn btn-signal btn-reveal" id="revealBtn" aria-keyshortcuts="Shift+R">Reveal votes<span class="btn-count" id="revealCount"></span></button>
      <button type="button" class="btn btn-signal btn-reveal" id="resetBtn" aria-keyshortcuts="Shift+N" hidden>New round</button>
      <button type="button" class="btn btn-danger" id="endBtn">End session</button>
    </div>
  </section>
</div>

<% if (userSession.isAdmin) { %>
<dialog class="dialog" id="endDialog" aria-labelledby="endDialogTitle" aria-describedby="endDialogText">
  <form method="dialog" class="dialog-body">
    <h2 class="dialog-title" id="endDialogTitle">End this session?</h2>
    <p class="dialog-text" id="endDialogText">The room closes for everyone and this round's votes are gone. You can't undo this.</p>
    <div class="dialog-actions">
      <button type="submit" class="btn btn-quiet" value="cancel" autofocus>Keep the room</button>
      <button type="submit" class="btn btn-danger" value="end">End for everyone</button>
    </div>
  </form>
</dialog>
<% } %>

<div id="room-data"
  data-room-id="<%= room.id %>"
  data-task-title="<%= room.taskTitle %>"
  data-task-description="<%= (room.taskDescription || '').replace(/"/g, '&quot;') %>"
  data-admin-name="<%= room.adminName %>"
  data-user-name="<%= userSession.name %>"
  data-is-admin="<%= userSession.isAdmin %>"
  hidden
></div>

<%- contentFor('rail') %>
<div class="countdown" id="roomTimer" role="timer" aria-label="Time until the room closes">
  <span class="countdown-label">Closes in</span>
  <% const remainingSeconds = Math.ceil(remainingMs / 1000); %>
  <span class="countdown-value" id="timerDisplay"><%= Math.floor(remainingSeconds / 60) %>:<%= String(remainingSeconds % 60).padStart(2, "0") %></span>
</div>
